# ---- Required: Telegram bot ----
# Create the bot with @BotFather in Telegram and paste the token it gives you
TELEGRAM_BOT_TOKEN=
# polling (default): the bot fetches messages itself, no public URL needed.
# webhook: Telegram calls https://<PUBLIC_BASE_URL>/telegram/webhook; needs PUBLIC_BASE_URL and a secret.
TELEGRAM_MODE=polling
# only for TELEGRAM_MODE=webhook: any random string (letters, digits, _ and -)
# TELEGRAM_WEBHOOK_SECRET=

# ---- Required: Gemini ----
# If anyone will connect Gmail/Calendar/Drive, use a key from a project with BILLING ENABLED (shows as "Paid" in
# AI Studio). On the free tier Google may use submitted content to improve its products and humans may review it,
# which contradicts the privacy policy the bot serves at /privacy. See docs/TERMS_TEMPLATE.md
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# ---- Required: Google OAuth (Calendar / Gmail / Drive) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assistant.your-domain.example/oauth/callback
# Fernet key that encrypts Google tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Storage ----
DB_PATH=./data/assistant.db

# ---- Region (defaults are for Israel) ----
# IANA timezone for new users and the daily jobs, e.g. Europe/London, America/New_York
DEFAULT_TIMEZONE=Asia/Jerusalem
# City used when someone asks for the weather without naming one
DEFAULT_LOCATION=Tel Aviv
# Language of the messages the bot composes itself: he or en (see README, "Language")
LOCALE=he

# ---- Admin dashboard (served only on ADMIN_HOST, behind Cloudflare Access) ----
ADMIN_HOST=admin.your-domain.example
# The dashboard stays OFF until this is set (only this Cloudflare Access identity gets in)
ADMIN_ALLOWED_EMAIL=
# Recommended: verify Cloudflare Access's signed JWT instead of trusting a header.
# Team domain like myteam.cloudflareaccess.com; AUD = the Access application's "Application Audience (AUD) Tag"
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Shown on the /about, /privacy and /terms pages (Google's OAuth consent screen requires a privacy page)
ADMIN_CONTACT_EMAIL=
# Your name as the person running this instance - named on /privacy and /terms as the data controller
OPERATOR_NAME=
# Public https address of this bot, no trailing slash. Used to send each newly added user a one-time welcome with
# the /privacy and /terms links (needs the `welcome_user` template, see the README). Empty = no welcome message.
PUBLIC_BASE_URL=

# ---- Optional: cost guard (reports go ONLY to this number) ----
# digits only, international format
OWNER_CHAT_ID=
COST_ALERT_BUDGET_USD=15
# Real billing via BigQuery billing export (optional; falls back to a token estimate)
GCP_BILLING_SA_KEY_PATH=
GCP_BILLING_PROJECT_ID=
GCP_BILLING_DATASET=

# ---- Optional integrations (inert unless set) ----
# package tracking
SHIP24_API_KEY=
ZABBIX_API_URL=http://localhost:8081/api_jsonrpc.php
ZABBIX_API_TOKEN=
UNIFI_HOST=https://192.168.1.1
UNIFI_API_KEY=
FIREWALLA_MSP_DOMAIN=
FIREWALLA_API_TOKEN=

# ---- Optional: Docker Cloudflare tunnel profile ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Optional: OpenAI as a second AI provider (users switch with "switch to OpenAI") ----
# Needs BOTH a key and a model name; there is deliberately no default model. Gemini stays the default and still does
# embeddings (memory search) and image generation. Turning this on sends the chosen users' content to OpenAI:
# /privacy and the welcome message mention it automatically. See docs/ADDING_A_PROVIDER.md.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# AI_DEFAULT_PROVIDER=gemini
# Optional USD per million tokens, only for the cost report (unset = reported as "unpriced", never as free):
# OPENAI_PRICE_INPUT_PER_M=
# OPENAI_PRICE_CACHED_INPUT_PER_M=
# OPENAI_PRICE_OUTPUT_PER_M=
# OPENAI_PRICE_WEB_SEARCH_PER_CALL=
